// FiveM (asi-five) refuses any .asi on game build 2189+ that does not claim support for the running
// build. It does FindResource(module, L"FX_ASI_BUILD", MAKEINTRESOURCE(GetGameBuild())), so the
// resource NAME is FX_ASI_BUILD and its TYPE is the build number. One line per supported build.
// Servers pin their own build, so one line is not enough: a server on b3407 refused the plugin
// outright and produced no log at all, which reads as "it does nothing" (issue #10). A line for a
// build that does not exist costs nothing, a missing one fails in silence, so claim them broadly.
// If a pattern does not match on an older build the plugin says so and disables itself, which is
// a failure someone can actually read. Add a line when the build ladder moves.
FX_ASI_BUILD 2189 BEGIN "\0" END
FX_ASI_BUILD 2372 BEGIN "\0" END
FX_ASI_BUILD 2545 BEGIN "\0" END
FX_ASI_BUILD 2612 BEGIN "\0" END
FX_ASI_BUILD 2699 BEGIN "\0" END
FX_ASI_BUILD 2802 BEGIN "\0" END
FX_ASI_BUILD 2944 BEGIN "\0" END
FX_ASI_BUILD 3095 BEGIN "\0" END
FX_ASI_BUILD 3258 BEGIN "\0" END
FX_ASI_BUILD 3407 BEGIN "\0" END
FX_ASI_BUILD 3442 BEGIN "\0" END
FX_ASI_BUILD 3570 BEGIN "\0" END
FX_ASI_BUILD 3679 BEGIN "\0" END
FX_ASI_BUILD 3751 BEGIN "\0" END
FX_ASI_BUILD 3775 BEGIN "\0" END
FX_ASI_BUILD 3788 BEGIN "\0" END

// Version resource. An unsigned binary with NO version info at all is itself a weighting factor
// in Defender's ML and SmartScreen scoring, and it leaves a player who right-clicks the file with
// nothing to look at. Keep FILEVERSION/PRODUCTVERSION in step with TEXOVERRIDE_VERSION on bumps.
// Literal numbers rather than the winver.h names so the .rc never depends on an include path.
1 VERSIONINFO
FILEVERSION    0,8,18,0
PRODUCTVERSION 0,8,18,0
FILEFLAGSMASK  0x3fL
FILEFLAGS      0x0L
FILEOS         0x40004L
FILETYPE       0x2L
FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "blancodagoat"
            VALUE "FileDescription",  "texoverride - draws your own .ydd and .ytd files on your ped in FiveM"
            VALUE "FileVersion",      "0.8.18.0"
            VALUE "InternalName",     "texoverride"
            VALUE "LegalCopyright",   "Copyright (c) 2026 blancodagoat. MIT licensed."
            VALUE "OriginalFilename", "texoverride.asi"
            VALUE "ProductName",      "texoverride"
            VALUE "ProductVersion",   "0.8.18.0"
            VALUE "Comments",         "Source and releases: https://github.com/blancodagoat/texoverride"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
